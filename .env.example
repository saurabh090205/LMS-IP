# ========================================================
# Shreenil Platform - Environment Configuration Example
# ========================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=shreenildb
POSTGRES_USER=shreenil
POSTGRES_PASSWORD=shreenil_secret_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Keycloak Identity & Access Management
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=shreenil
KEYCLOAK_CLIENT_ID=shreenil-frontend

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8081
APP_AUTH_DEV_BYPASS_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5174,http://localhost:5173,http://localhost:3000

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8081/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=shreenil
VITE_KEYCLOAK_CLIENT_ID=shreenil-frontend
